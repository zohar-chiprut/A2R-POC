{
   "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "allowJs": false,
      "target": "es6"
    }
  },
  "compileOnSave": false,
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
     "noImplicitAny": true,
    "target": "es5",
    "typeRoots": ["node_modules/@types"],
     "lib": ["es6", "dom"],
     "paths": {
      "@app/*": ["./src/app/*"],
      "@environments/*": ["./src/environments/*"]
    },
  },
   "exclude": ["node_modules"],
   "include": [
    "./src/main.ts",
    "./src/polyfills.ts"
  ]
}
